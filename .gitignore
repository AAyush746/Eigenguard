# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node
node_modules/
npm-debug.log*
yarn-error.log*
.pnpm-store/

# Honeypot runtime state.
# The database, the generated host key and the WAL sidecars are all per-machine
# and per-run: committing them would leak captured credentials and ship a host
# key whose private half is in the repository.
honeypot/data/*.db
honeypot/data/*.db-shm
honeypot/data/*.db-wal
honeypot/data/ssh_host_key
honeypot/logs/
honeypot/.run/

# GeoLite2 requires a MaxMind licence and cannot be redistributed here.
honeypot/data/*.mmdb

# Captured traffic is regenerated by the pipeline and can be large.
data/generated/

# The dataset is 3.4 MB and reproducible from ml/generate_dataset.py, so it is
# not committed. Reproduce with the commands in docs/model_card.md.
data/http_dataset.csv

# model_metrics.json and feature_importance.png ARE committed: the README and
# docs/model_card.md quote their numbers, and a performance claim with no
# tracked evidence behind it is not reviewable. Both are small (~63 KB total).

# Local environment
.env
.env.*
!.env.example
.DS_Store
.idea/
.vscode/